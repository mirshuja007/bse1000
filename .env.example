# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already excluded via .gitignore.
#
# Get KITE_API_KEY / KITE_API_SECRET from https://developers.kite.trade (your Connect app).
# KITE_TOTP_SECRET is the base32 secret shown when you set up TOTP 2FA on Zerodha
# (the string encoded in the QR code, not a 6-digit code).

KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Password used to protect the Streamlit app itself (optional, recommended if you
# ever host it on a shared or public URL).
APP_PASSWORD=
